<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Fade between screens -->
    <style name="WindowAnimationFade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="Base.Theme.TutorSync" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/ts_primary</item>
        <item name="colorOnPrimary">@color/ts_on_primary</item>
        <item name="colorPrimaryContainer">@color/ts_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ts_on_primary_container</item>

        <item name="colorSecondary">@color/ts_secondary</item>
        <item name="colorOnSecondary">@color/ts_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ts_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ts_on_secondary_container</item>

        <item name="colorTertiary">@color/ts_tertiary</item>
        <item name="colorOnTertiary">@color/ts_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ts_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ts_on_tertiary_container</item>

        <!-- Surfaces & backgrounds -->
        <item name="android:colorBackground">@color/ts_background</item>
        <item name="colorOnBackground">@color/ts_on_background</item>
        <item name="colorSurface">@color/ts_surface</item>
        <item name="colorOnSurface">@color/ts_on_surface</item>
        <item name="colorSurfaceVariant">@color/ts_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ts_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/ts_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/ts_surface_low</item>
        <item name="colorSurfaceContainer">@color/ts_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/ts_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/ts_surface_highest</item>
        <item name="colorSurfaceDim">@color/ts_surface_dim</item>
        <item name="colorSurfaceBright">@color/ts_surface_bright</item>
        <item name="colorSurfaceInverse">@color/ts_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/ts_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/ts_inverse_primary</item>

        <!-- Outlines & borders -->
        <item name="colorOutline">@color/ts_outline</item>
        <item name="colorOutlineVariant">@color/ts_outline_variant</item>

        <!-- Error -->
        <item name="colorError">@color/ts_error</item>
        <item name="colorOnError">@color/ts_on_error</item>
        <item name="colorErrorContainer">@color/ts_error_container</item>
        <item name="colorOnErrorContainer">@color/ts_on_error_container</item>

        <!-- Scrim -->
        <item name="scrimBackground">@color/ts_scrim</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/ts_background</item>
        <item name="android:navigationBarColor">@color/ts_background</item>
        <item name="android:windowLightStatusBar">@bool/ts_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/ts_light_system_bars</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationFade</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Font -->
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>

        <!-- Type scale -->
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.TutorSync.DisplaySmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.TutorSync.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.TutorSync.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.TutorSync.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.TutorSync.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.TutorSync.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.TutorSync.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.TutorSync.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.TutorSync.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.TutorSync.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.TutorSync.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.TutorSync.LabelSmall</item>

        <!-- Shapes (8 / 12 / 16 / 24 dp) -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.TutorSync.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.TutorSync.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.TutorSync.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.TutorSync.ExtraLarge</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TutorSync.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TutorSync.Medium</item>

        <!-- Default component styles: every Material widget picks these up without a style attribute -->
        <item name="materialCardViewStyle">@style/Widget.TutorSync.Card</item>
        <item name="materialButtonStyle">@style/Widget.TutorSync.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.TutorSync.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.TutorSync.TextInput</item>
        <item name="toolbarStyle">@style/Widget.TutorSync.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.TutorSync.BottomNav</item>
        <item name="snackbarStyle">@style/Widget.TutorSync.Snackbar</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.TutorSync.Progress.Linear</item>
        <item name="materialDividerStyle">@style/Widget.TutorSync.Divider</item>
        <item name="floatingActionButtonStyle">@style/Widget.TutorSync.FAB</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.TutorSync.ExtendedFAB</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TutorSync.MaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.TutorSync.BottomSheetDialog</item>
    </style>

    <style name="Theme.TutorSync" parent="Base.Theme.TutorSync" />

    <!-- Branded Splash Screen theme (AndroidX core-splashscreen) -->
    <style name="Theme.TutorSync.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ts_hero</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TutorSync</item>
    </style>

</resources>