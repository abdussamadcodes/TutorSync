<?xml version="1.0" encoding="utf-8"?>
<!--
    TutorSync color tokens - LIGHT theme.
    Same names in values/ and values-night/. No hex in layouts: use these tokens or ?attr/ theme colors.
    Every text/background pair is 4.5:1 or better; outline vs surface is 3:1 or better.
-->
<resources>

    <!-- Brand: deep teal (primary) + teal tonal secondary. Amber is the tertiary role = money / due accents. -->
    <color name="ts_primary">#0B5F63</color>
    <color name="ts_on_primary">#FFFFFF</color>
    <color name="ts_primary_container">#BFE8E6</color>
    <color name="ts_on_primary_container">#00292B</color>
    <color name="ts_secondary">#24777B</color>
    <color name="ts_on_secondary">#FFFFFF</color>
    <color name="ts_secondary_container">#D2EEED</color>
    <color name="ts_on_secondary_container">#00282A</color>
    <color name="ts_tertiary">#8A5A00</color>
    <color name="ts_on_tertiary">#FFFFFF</color>
    <color name="ts_tertiary_container">#FFE6B0</color>
    <color name="ts_on_tertiary_container">#2B1B00</color>

    <!-- Neutrals: slate-teal surfaces; outline = 3:1+ for borders, outline_variant = subtle card borders -->
    <color name="ts_background">#F5F8F8</color>
    <color name="ts_on_background">#0F1E20</color>
    <color name="ts_surface">#FFFFFF</color>
    <color name="ts_on_surface">#0F1E20</color>
    <color name="ts_surface_variant">#E6EEEF</color>
    <color name="ts_on_surface_variant">#41545A</color>
    <color name="ts_surface_lowest">#FFFFFF</color>
    <color name="ts_surface_low">#F1F6F6</color>
    <color name="ts_surface_container">#EBF1F2</color>
    <color name="ts_surface_high">#E4ECED</color>
    <color name="ts_surface_highest">#DDE6E7</color>
    <color name="ts_surface_dim">#D5DEDF</color>
    <color name="ts_surface_bright">#FFFFFF</color>
    <color name="ts_outline">#6B7F84</color>
    <color name="ts_outline_variant">#D3DEDF</color>
    <color name="ts_inverse_surface">#223234</color>
    <color name="ts_inverse_on_surface">#EAF2F3</color>
    <color name="ts_inverse_primary">#7ED6D4</color>

    <!-- Semantic: error (Unpaid, Absent) -->
    <color name="ts_error">#BA1A1A</color>
    <color name="ts_on_error">#FFFFFF</color>
    <color name="ts_error_container">#FFDAD6</color>
    <color name="ts_on_error_container">#410002</color>

    <!-- Semantic: success (Paid, Present) -->
    <color name="ts_success">#17703F</color>
    <color name="ts_on_success">#FFFFFF</color>
    <color name="ts_success_container">#D4F1DD</color>
    <color name="ts_on_success_container">#06361B</color>

    <!-- Semantic: warning (Partial, Due soon) -->
    <color name="ts_warning">#8A5A00</color>
    <color name="ts_on_warning">#FFFFFF</color>
    <color name="ts_warning_container">#FFE6B0</color>
    <color name="ts_on_warning_container">#2B1B00</color>

    <!-- Semantic: info (Makeup) -->
    <color name="ts_info">#1D5DA3</color>
    <color name="ts_on_info">#FFFFFF</color>
    <color name="ts_info_container">#D7E7FB</color>
    <color name="ts_on_info_container">#0A2A4E</color>

    <!-- Semantic: neutral (Cancelled, Void) -->
    <color name="ts_neutral">#4A5A5E</color>
    <color name="ts_on_neutral">#FFFFFF</color>
    <color name="ts_neutral_container">#E2E9EA</color>
    <color name="ts_on_neutral_container">#1A2527</color>

    <!-- Hero card (dashboard money summary) -->
    <color name="ts_hero">#0B5F63</color>
    <color name="ts_on_hero">#FFFFFF</color>
    <color name="ts_on_hero_muted">#C4E6E5</color>
    <color name="ts_hero_accent">#FFD27A</color>
    <color name="ts_hero_track">#3A8588</color>

    <!-- Scrim -->
    <color name="ts_scrim">#000000</color>

    <!-- Dark status/navigation bar icons: true on light theme, false on dark theme -->
    <bool name="ts_light_system_bars">true</bool>

</resources>