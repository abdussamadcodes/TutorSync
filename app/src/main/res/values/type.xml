<?xml version="1.0" encoding="utf-8"?>
<!--
    TutorSync type scale. Plus Jakarta Sans for Latin text and numerals; Bangla glyphs (and the taka sign)
    fall back to the system Bengali font, so line heights are generous (about 1.5x) and letterSpacing is 0
    (letter spacing can break Bangla conjuncts). Money uses tabular numerals so amounts line up.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Scale: mapped to the theme textAppearance* attributes, so ?attr/textAppearanceBodyMedium etc. use these -->
    <style name="TextAppearance.TutorSync.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineHeight" tools:targetApi="p">@dimen/lh_display</item>
        <item name="lineHeight">@dimen/lh_display</item>
    </style>

    <style name="TextAppearance.TutorSync.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">@dimen/text_headline_md</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineHeight" tools:targetApi="p">@dimen/lh_headline_md</item>
        <item name="lineHeight">@dimen/lh_headline_md</item>
    </style>

    <style name="TextAppearance.TutorSync.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
