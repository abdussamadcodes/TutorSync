<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Top Row: Brand Mark + Step Badge + Optional Back Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TutorSync.Card.Tonal"
                    android:layout_width="@dimen/avatar_lg"
                    android:layout_height="@dimen/avatar_lg"
                    app:cardCornerRadius="@dimen/radius_md">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tutor_logo"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.TutorSync.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvStepBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/setup_step_1_of_2"
                        android:textAppearance="@style/TextAppearance.TutorSync.LabelMedium"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStepBack"
                    style="@style/Widget.TutorSync.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_action_back"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- 2-Step Progress Bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/setupProgress"
                style="@style/Widget.TutorSync.Progress.Linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:max="100"
                android:progress="50" />

            <!-- Step Title & Subtitle -->
            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/setup_lang_title"
                android:textAppearance="@style/TextAppearance.TutorSync.HeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvStepSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/setup_lang_subtitle"
                android:textAppearance="@style/TextAppearance.TutorSync.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- ========================================================= -->
            <!-- STEP 1: LANGUAGE SELECTION CARDS                          -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/stepContainerLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="vertical">

                <!-- English Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLangEnglish"
                    style="@style/Widget.TutorSync.Card.Selectable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="76dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.TutorSync.Card.Tonal"
                            android:layout_width="@dimen/avatar_md"
                            android:layout_height="@dimen/avatar_md"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TutorSync.Circle">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/setup_lang_en_badge"
                                android:textAppearance="@style/TextAppearance.TutorSync.TitleSmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_lang_en_title"
                                android:textAppearance="@style/TextAppearance.TutorSync.TitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/setup_lang_en_desc"
                                android:textAppearance="@style/TextAppearance.TutorSync.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bangla Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLangBangla"
                    style="@style/Widget.TutorSync.Card.Selectable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="76dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.TutorSync.Card.Tonal"
                            android:layout_width="@dimen/avatar_md"
                            android:layout_height="@dimen/avatar_md"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TutorSync.Circle">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/setup_lang_bn_badge"
                                android:textAppearance="@style/TextAppearance.TutorSync.TitleSmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_lang_bn_title"
                                android:textAppearance="@style/TextAppearance.TutorSync.TitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/setup_lang_bn_desc"
                                android:textAppearance="@style/TextAppearance.TutorSync.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- STEP 2: THEME PREVIEW CARDS (Full labels, no truncation)  -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/stepContainerTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 1. System Default Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeSystem"
                    style="@style/Widget.TutorSync.Card.Selectable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="84dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <!-- Split Light/Dark Mini Preview Swatch -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.TutorSync.Card.Flat"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/ts_surface_bright" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@color/ts_inverse_surface" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_theme_system_title"
                                android:textAppearance="@style/TextAppearance.TutorSync.TitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/setup_theme_system_desc"
                                android:textAppearance="@style/TextAppearance.TutorSync.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Light Mode Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeLight"
                    style="@style/Widget.TutorSync.Card.Selectable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="84dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <!-- Light Mini Preview Swatch -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.TutorSync.Card.Flat"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardBackgroundColor="@color/ts_surface_bright">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_pill"
                                android:backgroundTint="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_theme_light_title"
                                android:textAppearance="@style/TextAppearance.TutorSync.TitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/setup_theme_light_desc"
                                android:textAppearance="@style/TextAppearance.TutorSync.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Dark Mode Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeDark"
                    style="@style/Widget.TutorSync.Card.Selectable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="84dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <!-- Dark Mini Preview Swatch -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.TutorSync.Card.Flat"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardBackgroundColor="@color/ts_inverse_surface">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_pill"
                                android:backgroundTint="@color/ts_hero_accent" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setup_theme_dark_title"
                                android:textAppearance="@style/TextAppearance.TutorSync.TitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/setup_theme_dark_desc"
                                android:textAppearance="@style/TextAppearance.TutorSync.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Sticky Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            style="@style/Widget.TutorSync.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_action_continue" />
    </LinearLayout>

</LinearLayout>