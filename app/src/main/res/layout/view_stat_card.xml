<?xml version="1.0" encoding="utf-8"?>
<!-- Content of StatCardView (merged into the MaterialCardView). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/statIcon"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginEnd="@dimen/space_xs"
                android:importantForAccessibility="no"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/statLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.TutorSync.Meta" />
        </LinearLayout>

        <TextView
            android:id="@+id/statValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:autoSizeMaxTextSize="@dimen/text_headline_sm"
            android:autoSizeMinTextSize="@dimen/text_body_sm"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.TutorSync.MoneyLarge"
            tools:ignore="UnusedAttribute" />
    </LinearLayout>
</merge>