<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TutorSync" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/ts_primary</item>
        <item name="colorOnPrimary">@color/ts_on_primary</item>
        <item name="colorPrimaryContainer">@color/ts_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ts_on_primary_container</item>

        <item name="colorSecondary">@color/ts_secondary</item>
        <item name="colorOnSecondary">@color/ts_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ts_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ts_on_secondary_container</item>

        <item name="colorTertiary">@color/ts_tertiary</item>
        <item name="colorOnTertiary">@color/ts_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ts_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ts_on_tertiary_container</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:colorBackground">@color/ts_background</item>
        <item name="colorOnBackground">@color/ts_on_background</item>
        <item name="colorSurface">@color/ts_surface</item>
        <item name="colorOnSurface">@color/ts_on_surface</item>
        <item name="colorSurfaceVariant">@color/ts_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ts_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/ts_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/ts_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/ts_inverse_primary</item>

        <!-- Outlines & Borders -->
        <item name="colorOutline">@color/ts_outline</item>
        <item name="colorOutlineVariant">@color/ts_outline_variant</item>

        <!-- Errors -->
        <item name="colorError">@color/ts_error</item>
        <item name="colorOnError">@color/ts_on_error</item>
        <item name="colorErrorContainer">@color/ts_error_container</item>
        <item name="colorOnErrorContainer">@color/ts_on_error_container</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/ts_background</item>
        <item name="android:navigationBarColor">@color/ts_background</item>
        <item name="android:windowLightStatusBar">@bool/ts_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/ts_light_system_bars</item>
    </style>

</resources>