    <string name="auth2_recovery_email_msg">যদি \"%1$s\" ফায়ারবেস ইমেইল অথেনটিকেশনে নিবন্ধিত থাকে, আমরা এই ঠিকানায় একটি রিসেট লিংক পাঠাতে পারি।\n\nঅফলাইন পাসওয়ার্ডের ক্ষেত্রে আপনার লিংক করা গুগল অ্যাকাউন্ট দিয়ে সাইন ইন করতে পারেন অথবা ব্যাকআপ ফাইল থেকে ডেটা পুনরুদ্ধার করতে পারেন।</string>
    <string name="auth2_recovery_send_email">রিসেট ইমেইল পাঠান</string>
    <string name="auth2_recovery_email_sent">%1$s ঠিকানায় অনলাইন অ্যাকাউন্ট থাকলে পাসওয়ার্ড রিসেট ইমেইল পাঠানো হয়েছে।</string>

