    <string name="auth2_recovery_google_title">গুগল অ্যাকাউন্ট পুনরুদ্ধার</string>
    <string name="auth2_recovery_google_msg">\"%1$s\" অ্যাকাউন্টটি গুগল সাইন-ইনের সাথে যুক্ত এবং এতে কোনো লোকাল পাসওয়ার্ড নেই।\n\nসরাসরি প্রবেশ করতে \"গুগল দিয়ে সাইন ইন\" ট্যাপ করুন অথবা গুগলের মাধ্যমে আপনার গুগল পাসওয়ার্ড রিসেট করুন।</string>
